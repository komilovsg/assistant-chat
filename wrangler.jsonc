{
  "name": "assistant-chat",
  "main": "src/worker.ts",
  // Bundles the frontend (public/app.js, public/widget.js) before every `wrangler dev` / `wrangler deploy` / Deploy Button.
  "build": { "command": "npm run build" },
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["enable_request_signal"], // request.signal fires when the client disconnects
  "observability": { "enabled": true },

  // Static frontend. run_worker_first so security headers (CSP etc.) are set in one place: src/worker.ts.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  // Daily counters + dead-model memo.
  // No "id": Wrangler (and the Deploy to Cloudflare button) creates the namespace on first deploy and fills the id in.
  // To bind an existing namespace instead, add its id: { "binding": "LIMITS", "id": "<id>" }.
  // (Local `wrangler dev` uses a local simulated KV.)
  "kv_namespaces": [
    { "binding": "LIMITS" }
  ],

  // Per-IP burst limit (Workers Rate Limiting binding). period must be 10 or 60 seconds.
  // namespace_id is any integer string unique within your account.
  "ratelimits": [
    { "name": "BURST", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  // Tunables. Secret GEMINI_API_KEY is NOT here: `npx wrangler secret put GEMINI_API_KEY` (local: .dev.vars).
  // Optional: SYSTEM_PROMPT (overrides the built-in Russian general-assistant prompt).
  "vars": {
    "APP_NAME": "Ассистент",
    "GREETING": "Привет! Чем могу помочь?",
    "DAILY_IP_LIMIT": "30",
    "DAILY_GLOBAL_LIMIT": "400",
    // Which other sites may embed the widget (call /api/*). "" = same-origin only (default, safest).
    // Comma list of exact origins: "https://shop.example.com,https://blog.example.org".
    // "*" = ANY site — then anyone can embed your widget and burn your daily global quota.
    "ALLOWED_ORIGINS": ""
  }
}
