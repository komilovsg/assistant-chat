{
  "name": "assistant-chat",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["enable_request_signal"], // request.signal fires when the client disconnects
  "observability": { "enabled": true },

  // Static frontend. run_worker_first so security headers (CSP etc.) are set in one place: src/worker.js.
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },

  // Daily counters + dead-model memo.
  // Create once:  npx wrangler kv namespace create LIMITS   → paste the printed id below.
  // (Local `wrangler dev` uses a local simulated KV, the placeholder id is fine there.)
  "kv_namespaces": [
    { "binding": "LIMITS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],

  // Per-IP burst limit (Workers Rate Limiting binding). period must be 10 or 60 seconds.
  // namespace_id is any integer string unique within your account.
  "ratelimits": [
    { "name": "BURST", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],

  // Tunables. Secret GEMINI_API_KEY is NOT here: `npx wrangler secret put GEMINI_API_KEY` (local: .dev.vars).
  "vars": {
    "DAILY_IP_LIMIT": "30",
    "DAILY_GLOBAL_LIMIT": "400"
  }
}
